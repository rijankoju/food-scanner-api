# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so keys stay on your machine.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: switch to Claude (pay-as-you-go key from console.anthropic.com)
# VISION_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Optional: a Gemini model with a bigger free quota
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: comma-separated browser origins allowed by CORS (Expo web dev server)
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://192.168.1.10:8082
